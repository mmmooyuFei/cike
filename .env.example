# 运行
TZ=Asia/Shanghai
# 应用计算“今天”所用时区（不依赖容器 TZ）
APP_TIMEZONE=Asia/Shanghai

# PostgreSQL 容器所在的 Docker 网络（应用会加入该网络）
DOCKER_NETWORK=postgres-network

# 数据库：按实际用户名、口令、服务别名修改
DATABASE_URL=postgresql+psycopg://cike:CHANGE_ME@postgres:5432/cike

# 会话与 Cookie
SESSION_SECRET=CHANGE_ME
COOKIE_SECURE=true

# OIDC（Casdoor）
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=CHANGE_ME
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_REDIRECT_URI=https://workbench.example.com/api/auth/oidc/callback
OIDC_SCOPES=openid profile email
OIDC_PKCE=true
OIDC_DISPLAY_NAME=统一登录
OIDC_AUTO_LOGIN=true
OIDC_POST_LOGOUT_REDIRECT_URI=https://workbench.example.com/
ADMIN_ROLE=admin

# 可选：角色定义重算与资料写回 Casdoor 所需的管理员账号
CASDOOR_ADMIN_USER=
CASDOOR_ADMIN_PASSWORD=
CASDOOR_APPLICATION=

# 品牌（站点名称与副标题，登录后管理员可在「账号设置 → 品牌与外观」修改）
BRAND_DEFAULT_NAME=此刻
BRAND_DEFAULT_SUBTITLE=笔记 · 备忘录

# 数据目录
DATA_DIR=data

# 更新管理（可选）
# 容器内仓库路径由 docker-compose.yml 的 environment 设置（默认 /repo）
# 是否允许页面重启进程（容器需有 restart 策略；默认关闭）
UPDATE_ALLOW_RESTART=false
# 是否允许「拉取并重建」；宿主机执行器装好后才会真正开放（见 README「宿主执行器」）
UPDATE_ALLOW_REBUILD=true
